# Gemini API key for the chatbot LLM (free tier from aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Optional: override the Gemini model. Defaults to gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Optional: model used to transcribe uploaded audio files via the Gemini Files API.
# Defaults to GEMINI_MODEL.
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Optional: Gemini Live model used for browser-recorded meetings.
# Defaults to models/gemini-2.5-flash-native-audio-latest (same as the voice-agent project).
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# Paperclip local API
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
# Note: company + agent IDs are NOT set here. They are written to
# .bootstrap/ids.json by `npm run bootstrap` and read from there by the
# chatbot (server/paperclip.ts). This keeps the IDs in sync after a DB wipe.

# Paths the backend reads for input staging (the agent's cwd)
WORKSPACE_PATH=/Users/tagariwalayashesh/Projects/buzzinga/requirement-generator

# Default workflow parameters — the chatbot uses these unless the user overrides in chat.
# The downstream pipeline stages (data model, solution design) need NO extra config:
# they reuse the Confluence space the requirements approval already created (keyed by
# the project name) and publish a standalone page each — Confluence only, no Jira.
DEFAULT_FEATURE_NAME=Review & Verify Evidence
DEFAULT_PROCESS_L3=2.4 Review & Verify evidence
DEFAULT_PROCESS_L4=2.4.1 Review evidence
DEFAULT_STARTING_STORY_NUMBER=2.4.1.1
DEFAULT_PARENT_EPIC_KEY=SADA-1
DEFAULT_JIRA_PROJECT_KEY=SADA
DEFAULT_CONFLUENCE_SPACE_KEY=SADA
DEFAULT_CONFLUENCE_PAGE_TITLE=Review & Verify Evidence

# ─── Atlassian auto-provisioning ────────────────────────────────────────────
# The Atlassian MCP can create pages/issues but NOT spaces/projects. At the
# approval step the chatbot creates the missing Jira project + Confluence space
# via the Atlassian REST API, before the BA pushes.
#
# AUTH — no setup needed by default: it reuses the OAuth login the client ALREADY
# does for the MCP (`npx mcp-remote … authv2`, cached in ~/.mcp-auth/). It only
# creates when a target is missing AND that login has permission; otherwise it
# soft-skips and the BA verifies/blocks. To create regardless of the MCP grant's
# scope, set an explicit API token below (Basic auth) — then it takes priority:
#   ATLASSIAN_SITE_URL=https://your-team.atlassian.net
#   ATLASSIAN_EMAIL=you@example.com
#   ATLASSIAN_API_TOKEN=        # https://id.atlassian.com/manage-profile/security/api-tokens
# (ATLASSIAN_SITE_URL alone also helps pick the right site when the MCP login can
#  reach several.)
# ATLASSIAN_SITE_URL=https://your-team.atlassian.net
#
# Optional overrides for Jira project creation (defaults suit a team-managed Kanban site):
# ATLASSIAN_JIRA_PROJECT_TYPE=software
# ATLASSIAN_JIRA_TEMPLATE_KEY=com.pyxis.greenhopper.jira:gh-simplified-kanban

# Server port
PORT=4000
