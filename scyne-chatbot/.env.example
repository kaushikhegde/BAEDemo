# Gemini API key for the chatbot LLM (free tier from aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Optional: override the Gemini model. Defaults to gemini-2.5-pro.
GEMINI_MODEL=gemini-2.5-flash

# Optional: model used to transcribe uploaded audio files via the Gemini Files API.
# Defaults to GEMINI_MODEL.
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash

# Optional: Gemini Live model used for browser-recorded meetings.
# Defaults to models/gemini-2.5-flash-native-audio-latest (same as the voice-agent project).
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# Paperclip local API
PAPERCLIP_API_URL=http://127.0.0.1:3100/api
PAPERCLIP_COMPANY_ID=2131f183-3822-4eee-9370-4b5cafae7e29
PAPERCLIP_PM_AGENT_ID=212a6542-4e49-41dc-94f0-7d7acbc460ba

# Paths the backend reads for input staging (the agent's cwd)
WORKSPACE_PATH=/Users/tagariwalayashesh/Projects/buzzinga/requirement-generator

# Default workflow parameters — the chatbot uses these unless the user overrides in chat.
DEFAULT_FEATURE_NAME=Review & Verify Evidence
DEFAULT_PROCESS_L3=2.4 Review & Verify evidence
DEFAULT_PROCESS_L4=2.4.1 Review evidence
DEFAULT_STARTING_STORY_NUMBER=2.4.1.1
DEFAULT_PARENT_EPIC_KEY=SADA-1
DEFAULT_JIRA_PROJECT_KEY=SADA
DEFAULT_CONFLUENCE_SPACE_KEY=SADA
DEFAULT_CONFLUENCE_PAGE_TITLE=Review & Verify Evidence

# Server port
PORT=4000
