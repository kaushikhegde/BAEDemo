# Scyne stack configuration. Copy to .env and fill in the secrets.
#   cp .env.example .env
# .env is gitignored.

# ─── Agent model auth — set EXACTLY ONE ─────────────────────────────────────
# Option A: pay-as-you-go API key.
ANTHROPIC_API_KEY=
# Option B: use your Claude subscription (no API key). On the host run:
#   claude setup-token
# and paste the long-lived token here. Leave ANTHROPIC_API_KEY empty so it wins.
# NOTE: mounting ~/.claude does NOT work on macOS (the login is in the Keychain,
# unreadable from the Linux container) — this token is the supported path.
CLAUDE_CODE_OAUTH_TOKEN=

# ─── Database ───────────────────────────────────────────────────────────────
# Unset  → PGlite, a local file at .orchestrator/pgdata. Single writer, so it
#          serves ONE machine and cannot back a shared server.
# Set    → a real PostgreSQL server. Required for more than one person.
# Migrations apply automatically on boot either way.
DATABASE_URL=

# ─── Agent adapter ──────────────────────────────────────────────────────────
# Moves EVERY agent onto one provider. Unset = claude_local (Claude Code).
# gemini needs GEMINI_API_KEY; azure_foundry needs the AZURE_AI_* pair below.
SCYNE_ADAPTER=

AZURE_AI_PROJECT_ENDPOINT=
# One of these two. Token: az account get-access-token --scope https://ai.azure.com/.default
AZURE_AI_TOKEN=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=gpt-4.1

# ─── Chatbot LLM (Gemini) ───────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# ─── Paperclip ──────────────────────────────────────────────────────────────
# CRITICAL: keep local_trusted — the image defaults to `authenticated`, which
# would 401 every agent + chatbot call. local_trusted treats localhost as admin.
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
BETTER_AUTH_SECRET=change-me-to-a-random-hex
PAPERCLIP_PORT_BASE=5174

# Generated-app dev server port range (published from the paperclip container).
# Caps concurrent generated apps; widen both ends together if you need more.
GEN_APP_PORT_MIN=5174
GEN_APP_PORT_MAX=5199

# ─── Chatbot workflow defaults ──────────────────────────────────────────────
# A user can say "process SADA / interim-benefit" and these fill the rest.
DEFAULT_FEATURE_NAME=Review & Verify Evidence
DEFAULT_PROCESS_L3=2.4 Review & Verify evidence
DEFAULT_PROCESS_L4=2.4.1 Review evidence
DEFAULT_STARTING_STORY_NUMBER=2.4.1.1
DEFAULT_PARENT_EPIC_KEY=SADA-1
DEFAULT_JIRA_PROJECT_KEY=SADA
DEFAULT_CONFLUENCE_SPACE_KEY=SADA
DEFAULT_CONFLUENCE_PAGE_TITLE=Review & Verify Evidence

# === Host-Paperclip mode (make client-hosted) only =========================
# Set these when the client runs Paperclip natively on the host and only the
# chatbot + bootstrap run in Docker (docker-compose.client.yml). Ignored by the
# all-in-Docker `make up` stack.
#
# Absolute path to the directory the host Paperclip uses as WORKSPACE_PATH.
# The chatbot + bootstrap bind-mount this so they share outputs/ and ids.json.
WORKSPACE_HOST_PATH=/absolute/path/to/requirement-generator
# Host Paperclip API URL as seen from the containers (network_mode: host →
# 127.0.0.1 is the host loopback, which keeps Paperclip's no-auth admin).
ORCHESTRATOR_API_URL=http://127.0.0.1:3100
