# Scyne stack configuration. Copy to .env and fill in the secrets.
#   cp .env.example .env
# .env is gitignored.

# ─── Agent model auth (default path) ────────────────────────────────────────
# Claude Code agents (PM/BA/UI/UX) use this. If left empty, claude-code falls
# back to a mounted host ~/.claude — see HOST_CLAUDE_DIR + the commented bind in
# docker-compose.yml. The API key wins when both are present.
ANTHROPIC_API_KEY=sk-ant-...
# Fallback only: path to your host Claude credentials dir. Uncomment the
# matching volume bind in docker-compose.yml to use it.
# HOST_CLAUDE_DIR=/Users/you/.claude

# ─── Chatbot LLM (Gemini) ───────────────────────────────────────────────────
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-latest

# ─── Paperclip ──────────────────────────────────────────────────────────────
# CRITICAL: keep local_trusted — the image defaults to `authenticated`, which
# would 401 every agent + chatbot call. local_trusted treats localhost as admin.
PAPERCLIP_DEPLOYMENT_MODE=local_trusted
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
BETTER_AUTH_SECRET=change-me-to-a-random-hex
PAPERCLIP_PORT_BASE=5174

# Generated-app dev server port range (published from the paperclip container).
# Caps concurrent generated apps; widen both ends together if you need more.
GEN_APP_PORT_MIN=5174
GEN_APP_PORT_MAX=5199

# ─── Chatbot workflow defaults ──────────────────────────────────────────────
# A user can say "process SADA / interim-benefit" and these fill the rest.
DEFAULT_FEATURE_NAME=Review & Verify Evidence
DEFAULT_PROCESS_L3=2.4 Review & Verify evidence
DEFAULT_PROCESS_L4=2.4.1 Review evidence
DEFAULT_STARTING_STORY_NUMBER=2.4.1.1
DEFAULT_PARENT_EPIC_KEY=SADA-1
DEFAULT_JIRA_PROJECT_KEY=SADA
DEFAULT_CONFLUENCE_SPACE_KEY=SADA
DEFAULT_CONFLUENCE_PAGE_TITLE=Review & Verify Evidence
