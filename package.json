{
  "name": "scyne-stack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local orchestration for the Scyne requirements generator stack. Runs on @scyne/orchestrator (packages/orchestrator) — no Paperclip.",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "chatbot": "cd scyne-chatbot && npm run dev",
    "link-skills": "mkdir -p .claude/skills && for s in skills/*/; do n=$(basename \"$s\"); rm -rf \".claude/skills/$n\"; ln -s \"../../skills/$n\" \".claude/skills/$n\"; done && ls -l .claude/skills",
    "stage": "node scripts/stage.mjs",
    "migrate": "node scripts/migrate-to-project-level.mjs",
    "convert": "node scripts/convert-to-md.mjs",
    "brand": "node scripts/extract-brand.mjs",
    "app": "node scripts/render-companion-app.mjs",
    "orch": "tsx packages/orchestrator/src/cli.ts",
    "db": "node scripts/db-query.mjs",
    "serve": "npm run orch -- serve --port 3100",
    "dev": "concurrently -n orch,app -c blue,green \"npm:serve\" \"npm run chatbot\"",
    "ado:verify": "node scripts/ado-publish.mjs --verify",
    "smoke": "node scripts/smoke-test.mjs",
    "mcp:test": "tsx scripts/mcp-test.mjs",
    "check:routing": "tsx scripts/check-routing.mts",
    "check:workflows": "tsx scripts/check-workflows.mts",
    "backfill:definitions": "node scripts/backfill-project-definitions.mjs",
    "sync:docs": "node scripts/sync-documents.mjs",
    "backfill:ado": "node scripts/backfill-ado-target.mjs",
    "migrate:blobs": "./packages/orchestrator/node_modules/.bin/tsx scripts/migrate-blobs-to-azure.mjs",
    "migrate:blobs:local": "./packages/orchestrator/node_modules/.bin/tsx scripts/migrate-blobs-to-local.mjs",
    "scyne": "node cli/index.ts",
    "test:cli": "node --test \"cli/*.test.ts\"",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\" \"test/**/*.test.mjs\"",
    "build:cli": "node scripts/build-cli.mjs",
    "pack:cli": "node scripts/build-cli.mjs && npm pack ./dist/cli --pack-destination ./dist",
    "typecheck": "./packages/orchestrator/node_modules/.bin/tsc --noEmit -p packages/orchestrator/tsconfig.json && ./packages/orchestrator/node_modules/.bin/tsc --noEmit -p cli/tsconfig.json",
    "test": "npm --prefix packages/orchestrator test",
    "check:publish": "node scripts/lib/publish-shared.test.mjs && node scripts/lib/ado.test.mjs && node scripts/lib/atlassian.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.2"
  },
  "bin": {
    "scyne": "./cli/index.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1120.0",
    "@azure/storage-blob": "^12.33.0",
    "@scyne/orchestrator": "file:packages/orchestrator"
  }
}
