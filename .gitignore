# OS / editor
.DS_Store
.idea/
.vscode/
.claude/

# Secrets
.env
.env.local
.env.*.local
# Any copy of it. `.env` was ignored and `.env.bak` was not, so the usual
# instinct before editing a secrets file produced an untracked file holding
# every credential, one `git add -A` from the history. The negation keeps the
# committed template visible.
.env.*
!.env.example
*.pem
*.key

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
dist/
build/
.cache/
.parcel-cache/
*.tsbuildinfo

# Runtime data / generated content
inputs/
inputs-source/
outputs/
projects/
generated-apps/
input-files/
dummy/

# Per-machine bootstrap output — written by `npm run bootstrap` against the LOCAL
# Paperclip. Holds this machine's company + agent IDs. MUST NOT be committed: the
# chatbot prefers ids.json over .env, so a stray copy would override the client's
# freshly-bootstrapped IDs and break their run.
.bootstrap/

# Misc
*.log
coverage/

# Client handoff base-image tarball (hundreds of MB — never commit)
paperclip-base.tar.gz

# Scyne orchestrator runtime data (PGlite data dir, run logs)
.orchestrator/

# graphify knowledge graph (local index)
graphify-out/

# Brainstorming companion mockups (superpowers)
.superpowers/
